{
  "name": "moti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:database": "node scripts/with-test-database.mjs",
    "verify": "npm run verify:pstack && npm run lint && npm run typecheck && npm test && npm run test:database && npm run build && npm run test:e2e",
    "verify:pstack": "node scripts/verify-pstack.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "supabase": "3.1.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
