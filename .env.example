# Supabase project URL and anon (publishable) key. Server-only; never exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Google account "sub" of the only user allowed to open the library.
# Must match moti.owner_config.google_subject in the database. Empty means nobody is allowed.
MOTI_OWNER_GOOGLE_SUBJECT=
